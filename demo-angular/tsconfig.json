{
  "compilerOptions": {
    "module": "esnext",
    "target": "es2020",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmitHelpers": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "lib": [
      "es2018",
      "es2017",
      "dom",
      "es6",
      "ESNext"
    ],
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "app/*"
      ],
      "@nativescript/core": [
        "./node_modules/@nativescript/core"
      ],
      "@nativescript/core/*": [
        "./node_modules/@nativescript/core/*"
      ]
    },
    "removeComments": false
  },
  "include": [
    "src/tests/**/*.ts",
    "src/**/*.ios.ts",
    "src/**/*.android.ts",
    "../src/**/*.ts"
  ],
  "files": [
    "./references.d.ts",
    "./src/main.ts",
    "../src/oauth.ts",
    "./src/polyfills.ts"
  ],
  "exclude": [
    "node_modules",
    "platforms",
    "e2e",
    "../src/nativescript.config.ts"
  ]
}
